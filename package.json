{
  "name": "ruye-resume",
  "private": true,
  "version": "0.1.0",
  "description": "如页（Ruye）：开源、本地优先的中文技术简历编辑器。所见即导出。",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @ruye/web dev",
    "build": "pnpm --filter @ruye/web build",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web/tsconfig.json",
    "fonts": "node scripts/fonts.mjs",
    "smoke": "node scripts/smoke.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.0"
  },
  "optionalDependencies": {
    "@myriaddreamin/typst.ts": "^0.7.0",
    "@myriaddreamin/typst-ts-renderer": "^0.7.0",
    "@myriaddreamin/typst-ts-web-compiler": "^0.7.0"
  }
}
